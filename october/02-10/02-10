def to_binary(decimal):

    binary = ''
    while(decimal > 0):
        binary += str(decimal % 2)
        decimal = decimal // 2

    binary = binary[::-1]
    print(binary)

    return binary


#Tests:
to_binary(5) #should return "101".
to_binary(12) #should return "1100".
to_binary(50) #should return "110010".
to_binary(99) #should return "1100011".